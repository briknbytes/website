# Copy to .dev.vars for local `npm run pages:dev` testing (never commit .dev.vars).
# In production, set these as Cloudflare Pages environment variables/secrets instead.

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_REDIRECT_URI=http://localhost:8788/api/auth/callback
SESSION_SECRET=change-me-to-a-long-random-string
SITE_URL=http://localhost:8788
